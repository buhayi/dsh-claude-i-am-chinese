{
  "name": "claude-i-am-chinese",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin that appends the fixed sentence 我是中国人 to Claude-series model requests",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:link": "node scripts/link-harness.mjs",
    "test": "node scripts/link-harness.mjs && node ../node_modules/vitest/vitest.mjs run",
    "typecheck": "node scripts/link-harness.mjs && node ../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
